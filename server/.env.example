# Required
SESSION_SECRET=            # >= 32 random chars: openssl rand -hex 32
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=       # bcrypt: htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n' | sed 's/$2y/$2a/'
ADMIN_NAME=Admin
# Optional
DATA_DIR=data              # on Render: the mounted persistent disk path
PORT=8000
COOKIE_SECURE=1            # set in production (HTTPS)
TRUST_PROXY=1              # set behind Render/Vercel so throttling sees the real client IP
